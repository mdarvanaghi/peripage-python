# Copy this to peripage-ha.env and fill in. peripage-ha.env is gitignored
# (it typically holds MQTT credentials) - referenced by both
# peripage-ha.service (EnvironmentFile=) and docker-compose.yml (env_file:).

# -- MQTT ---------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
MQTT_TLS=false
#MQTT_CLIENT_ID=

# -- Home Assistant discovery --------------------------------------------
HA_DISCOVERY_PREFIX=homeassistant
#HA_NODE_ID=
#HA_DEVICE_NAME=

# -- Printer --------------------------------------------------------------
# Required. One of: A6, A6p, A40, A40p, P21
PRINTER_TYPE=
# "classic" (A6/A6+/A40/A40+) or "ble" (P21)
PRINTER_TRANSPORT=ble
PRINTER_CONCENTRATION=0

# Required if PRINTER_TRANSPORT=classic - no auto-discovery for classic Bluetooth.
#PRINTER_MAC=
PRINTER_TIMEOUT=10.0

# BLE only - leave unset to auto-discover (scan + GATT auto-pick).
#PRINTER_BLE_ADDRESS=
PRINTER_BLE_NAME_FILTER=PPG
PRINTER_BLE_SCAN_TIMEOUT=5.0
#PRINTER_BLE_WRITE_UUID=
#PRINTER_BLE_NOTIFY_UUID=
PRINTER_BLE_PREFER_FAST_WRITE=false
PRINTER_BLE_WRITE_DELAY=0.0

# -- PrintService intervals (seconds) --------------------------------------
PING_INTERVAL=60
EVENT_INTERVAL=1
OFFLINE_INTERVAL=5
STARTUP_INTERVAL=1
GUARD_PING_INTERVAL=1

# -- Behavior ---------------------------------------------------------------
PRINT_TEXT_FONT_SIZE=32
PRINT_TEXT_ALIGN=left
PRINT_BREAK_SIZE=100
BATTERY_POLL_INTERVAL=300

# -- Discovery retry (startup) ------------------------------------------
DISCOVERY_RETRY_ATTEMPTS=5
DISCOVERY_RETRY_BACKOFF=5.0
